# PayOps AI Backend Environment Configuration

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="PayOps AI Backend"
API_V1_PREFIX=/api/v1

# SQLite Database
DATABASE_URL=sqlite:///./payops.db

# JWT Security
SECRET_KEY=payops-ai-secure-jwt-key-32101a0e690743ad
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PayPal Sandbox Credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Financial Safety Threshold (in integer cents: 10000 = $100.00)
SENSITIVE_REFUND_THRESHOLD_CENTS=10000

# Local AI Configuration (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLAMA_MODEL=llama3.2:1b
QWEN_VL_MODEL=qwen2.5-vl:3b

# Structured Logging
LOG_LEVEL=INFO

